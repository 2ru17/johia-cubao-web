<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Custom Error Pages
  ErrorDocument 403 /403.html
  ErrorDocument 500 /500.html

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>
